# ── Browser (Vite, baked into the bundle — public by design) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_JWT=          # legacy JWT-format anon key, used for Edge Function calls (src/lib/notifyAssignment.js)
VITE_VAPID_PUBLIC_KEY=           # Web Push public key (src/hooks/usePushRegistration.js)

# ── Vercel serverless only (api/) — set in Vercel → Project → Environment Variables ──
RESEND_API_KEY=                  # api/send-notification.js
WEBHOOK_SECRET=                  # must match the x-webhook-secret header configured on the Supabase DB webhook
MONIES_SUPABASE_URL=             # api/create-monies-transaction.js — the separate CNA Monies project
MONIES_SUPABASE_ANON_KEY=
MONIES_ACCOUNT_ID=
MONIES_USER_ID=

# ── Supabase Edge Function secrets (supabase/functions/send-push) — set with `supabase secrets set` ──
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically)

# ── Local only ──
# SUPABASE_SERVICE_ROLE_KEY=     # only needed by scripts/backup.sh after RLS lockdown; never commit
